{
  "name": "margin-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first intellectual workspace powered by your Codex subscription",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:live": "tsx scripts/live-eval.ts",
    "test:browser": "playwright test",
    "setup": "tsx scripts/doctor.ts",
    "format": "prettier --write .github src server shared tests scripts docs README.md AGENTS.md CONTRIBUTING.md package.json tsconfig.json vite.config.ts playwright.config.ts index.html",
    "format:check": "prettier --check .github src server shared tests scripts docs README.md AGENTS.md CONTRIBUTING.md package.json tsconfig.json vite.config.ts playwright.config.ts index.html",
    "test:live:project": "tsx scripts/live-project-eval.ts",
    "test:live:excerpts": "tsx scripts/live-excerpts-eval.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@mozilla/readability": "^0.6.0",
    "@tiptap/extension-mathematics": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@uiw/react-codemirror": "^4.25.12",
    "dockview-react": "^8.9.0",
    "fastify": "^5.12.8",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^31.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "katex": "$katex"
  }
}
